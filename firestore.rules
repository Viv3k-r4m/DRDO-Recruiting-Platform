rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /applications/{applicationId} {
      // Anyone can read their own application
      // Admins (verified by mock claim or email) can read all
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.uid || request.auth.token.email == 'admin@rac.gov.in');
        
      // Applicants can create an application
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      
      // Applicants can update their own application (e.g. upload resume)
      // Admins can update any application
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.uid || request.auth.token.email == 'admin@rac.gov.in');
        
      allow delete: if request.auth != null && request.auth.token.email == 'admin@rac.gov.in';
    }

    match /mail/{mailId} {
      allow create: if request.auth != null &&
        request.auth.token.email == 'admin@rac.gov.in';
      allow read, update, delete: if false;
    }
  }
}
